---
import { WEAPON_DPS_PRESET_GROUPS, WEAPON_DPS_SOURCE } from '../data/weapon-dps-presets';
---

<section class="weapon-dps-tool" data-weapon-dps-calculator>
  <div class="tool-meta">
    <p>
      依 FC2 原站 `dpscalc.js` 公式重製，適合比較乙太、Cros、Rok 對武器帳面 DPS 的影響。
    </p>
    <p>
      資料快照：HTML Last-Modified `{WEAPON_DPS_SOURCE.htmlLastModified}`；JS Last-Modified `{WEAPON_DPS_SOURCE.scriptLastModified}`。
    </p>
  </div>

  <form class="calculator-grid" aria-label="武器 DPS 計算機">
    <fieldset>
      <legend>武器資料</legend>
      <label>
        <span>裝備預設</span>
        <select data-field="preset">
          <option value="">手動輸入</option>
          {
            WEAPON_DPS_PRESET_GROUPS.map((group) => (
              <optgroup label={group.label}>
                {group.presets.map((preset) => (
                  <option value={preset.id}>{preset.name}</option>
                ))}
              </optgroup>
            ))
          }
        </select>
      </label>

      <div class="inline-fields two">
        <label>
          <span>最小 Damage</span>
          <input data-field="minDamage" inputmode="decimal" type="number" step="any" value="0" />
        </label>
        <label>
          <span>最大 Damage</span>
          <input data-field="maxDamage" inputmode="decimal" type="number" step="any" value="0" />
        </label>
      </div>

      <label>
        <span>Speed</span>
        <input data-field="speed" inputmode="decimal" type="number" step="any" value="0" />
      </label>
    </fieldset>

    <fieldset>
      <legend>裝備 Mods</legend>
      <label>
        <span>Damage 強化（%）</span>
        <input data-field="damageEnhance" inputmode="decimal" type="number" step="any" value="0" />
      </label>
      <label>
        <span>攻擊速度增加（%）</span>
        <input data-field="attackSpeedIncrease" inputmode="decimal" type="number" step="any" value="0" />
      </label>
      <div class="toggle-row">
        <label>
          <input data-field="ether" type="checkbox" />
          <span>乙太</span>
        </label>
        <label>
          <input data-field="isTwoHand" type="checkbox" />
          <span>雙手武器</span>
        </label>
      </div>
    </fieldset>

    <fieldset>
      <legend>符文</legend>
      <label>
        <span>Weapon Damage（Cros）</span>
        <span class="rune-input">
          <input data-field="runeDamage" inputmode="numeric" type="number" min="0" step="1" value="0" />
          <output data-output="damageRuneValue">x 20</output>
        </span>
      </label>
      <label>
        <span>Weapon Speed（Rok）</span>
        <span class="rune-input">
          <input data-field="runeSpeed" inputmode="numeric" type="number" min="0" step="1" value="0" />
          <output data-output="speedRuneValue">x 0.07</output>
        </span>
      </label>
    </fieldset>

    <section class="result-panel" aria-live="polite" aria-label="計算結果">
      <h2>計算結果</h2>
      <dl>
        <div>
          <dt>Damage</dt>
          <dd><output data-output="damageRange">0 - 0</output></dd>
        </div>
        <div>
          <dt>Speed</dt>
          <dd><output data-output="speed">0.0</output></dd>
        </div>
        <div>
          <dt>DPS</dt>
          <dd><output data-output="dps">無法計算 DPS</output></dd>
        </div>
      </dl>
      <p data-output="sourceAlias" class="source-alias" hidden></p>
    </section>
  </form>
</section>

<script>
  import { calculateWeaponDps } from '../lib/weapon-dps-calculator';
  import { WEAPON_DPS_PRESETS } from '../data/weapon-dps-presets';

  const root = document.querySelector('[data-weapon-dps-calculator]');
  const presets = new Map(WEAPON_DPS_PRESETS.map((preset) => [preset.id, preset]));

  if (root instanceof HTMLElement) {
    const fields = {
      preset: root.querySelector('[data-field="preset"]'),
      minDamage: root.querySelector('[data-field="minDamage"]'),
      maxDamage: root.querySelector('[data-field="maxDamage"]'),
      speed: root.querySelector('[data-field="speed"]'),
      damageEnhance: root.querySelector('[data-field="damageEnhance"]'),
      attackSpeedIncrease: root.querySelector('[data-field="attackSpeedIncrease"]'),
      ether: root.querySelector('[data-field="ether"]'),
      isTwoHand: root.querySelector('[data-field="isTwoHand"]'),
      runeDamage: root.querySelector('[data-field="runeDamage"]'),
      runeSpeed: root.querySelector('[data-field="runeSpeed"]'),
    };
    const outputs = {
      damageRange: root.querySelector('[data-output="damageRange"]'),
      speed: root.querySelector('[data-output="speed"]'),
      dps: root.querySelector('[data-output="dps"]'),
      damageRuneValue: root.querySelector('[data-output="damageRuneValue"]'),
      speedRuneValue: root.querySelector('[data-output="speedRuneValue"]'),
      sourceAlias: root.querySelector('[data-output="sourceAlias"]'),
    };

    const inputValue = (field: Element | null) =>
      field instanceof HTMLInputElement || field instanceof HTMLSelectElement ? field.value : '0';
    const checkedValue = (field: Element | null) => field instanceof HTMLInputElement && field.checked;
    const setInputValue = (field: Element | null, value: number | string) => {
      if (field instanceof HTMLInputElement) field.value = String(value);
    };
    const setCheckedValue = (field: Element | null, value: boolean) => {
      if (field instanceof HTMLInputElement) field.checked = value;
    };
    const setText = (field: Element | null, value: string) => {
      if (field) field.textContent = value;
    };

    const render = () => {
      const result = calculateWeaponDps({
        minDamage: inputValue(fields.minDamage),
        maxDamage: inputValue(fields.maxDamage),
        speed: inputValue(fields.speed),
        damageEnhance: inputValue(fields.damageEnhance),
        attackSpeedIncrease: inputValue(fields.attackSpeedIncrease),
        ether: checkedValue(fields.ether),
        runeDamage: inputValue(fields.runeDamage),
        runeSpeed: inputValue(fields.runeSpeed),
        isTwoHand: checkedValue(fields.isTwoHand),
      });

      setText(outputs.damageRange, `${result.display.minDamage} - ${result.display.maxDamage}`);
      setText(outputs.speed, result.display.speed);
      setText(outputs.dps, result.display.dps);
      setText(outputs.damageRuneValue, `x ${result.damageRuneValue}`);
      setText(outputs.speedRuneValue, `x ${result.speedRuneValue}`);
    };

    const applyPreset = () => {
      const preset = presets.get(inputValue(fields.preset));
      if (!preset) {
        if (outputs.sourceAlias instanceof HTMLElement) outputs.sourceAlias.hidden = true;
        render();
        return;
      }
      setInputValue(fields.minDamage, preset.minDamage);
      setInputValue(fields.maxDamage, preset.maxDamage);
      setInputValue(fields.speed, preset.speed);
      setInputValue(fields.damageEnhance, preset.damageEnhance);
      setInputValue(fields.attackSpeedIncrease, preset.attackSpeedIncrease);
      setCheckedValue(fields.isTwoHand, preset.isTwoHand);
      if (outputs.sourceAlias instanceof HTMLElement) {
        outputs.sourceAlias.hidden = !preset.sourceName;
        outputs.sourceAlias.textContent = preset.sourceName
          ? `原站下拉名稱：${preset.sourceName}`
          : '';
      }
      render();
    };

    root.addEventListener('input', (event) => {
      if (event.target === fields.preset) applyPreset();
      else render();
    });
    root.addEventListener('change', (event) => {
      if (event.target === fields.preset) applyPreset();
      else render();
    });
    render();
  }
</script>

<style>
  .weapon-dps-tool {
    margin-block: 1.5rem 2rem;
  }

  .tool-meta {
    border-inline-start: 3px solid var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent-low), transparent 48%);
    padding: 0.75rem 1rem;
    border-radius: 0.375rem;
  }

  .tool-meta p {
    margin: 0;
    color: var(--sl-color-white);
  }

  .tool-meta p + p {
    margin-top: 0.35rem;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
  }

  .calculator-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  fieldset,
  .result-panel {
    min-width: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 1rem;
    background: var(--sl-color-bg);
  }

  legend,
  .result-panel h2 {
    padding: 0 0.25rem;
    margin: 0;
    color: var(--sl-color-white);
    font-size: 1rem;
    font-weight: 700;
  }

  .result-panel h2 {
    padding: 0;
  }

  label {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.85rem;
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
    font-weight: 650;
  }

  input,
  select {
    width: 100%;
    min-height: 2.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    padding: 0.45rem 0.6rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font: inherit;
  }

  input:focus-visible,
  select:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .inline-fields {
    display: grid;
    gap: 0.75rem;
  }

  .inline-fields.two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .toggle-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 0.9rem;
  }

  .toggle-row label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
  }

  .toggle-row input {
    width: 1.05rem;
    min-height: 1.05rem;
    accent-color: var(--sl-color-accent);
  }

  .rune-input {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.75rem;
    gap: 0.5rem;
    align-items: center;
  }

  .rune-input output {
    min-height: 2.5rem;
    display: inline-grid;
    place-items: center;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    color: var(--sl-color-gray-2);
    font-variant-numeric: tabular-nums;
  }

  .result-panel {
    grid-column: 1 / -1;
  }

  .result-panel dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1rem 0 0;
  }

  .result-panel div {
    border-radius: 0.375rem;
    background: var(--sl-color-gray-6);
    padding: 0.75rem;
    min-height: 5rem;
  }

  .result-panel dt {
    color: var(--sl-color-gray-2);
    font-size: 0.85rem;
    font-weight: 650;
  }

  .result-panel dd {
    margin: 0.35rem 0 0;
    color: var(--sl-color-white);
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .source-alias {
    margin: 0.75rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
  }

  @media (max-width: 58rem) {
    .calculator-grid {
      grid-template-columns: 1fr;
    }

    .result-panel dl {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 32rem) {
    .inline-fields.two,
    .rune-input {
      grid-template-columns: 1fr;
    }
  }
</style>

